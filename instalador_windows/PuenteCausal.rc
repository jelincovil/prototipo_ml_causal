#include <windows.h>
#include <winver.h>

1 RT_MANIFEST "PuenteCausal.manifest"

1 VERSIONINFO
FILEVERSION 1,0,4,0
PRODUCTVERSION 1,0,4,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "0C0A04B0"
    BEGIN
      VALUE "CompanyName", "Puente Causal\0"
      VALUE "FileDescription", "Instalador local de Puente Causal\0"
      VALUE "FileVersion", "1.0.4.0\0"
      VALUE "InternalName", "PuenteCausal\0"
      VALUE "OriginalFilename", "PuenteCausal.exe\0"
      VALUE "ProductName", "Puente Causal\0"
      VALUE "ProductVersion", "1.0.4.0\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0xC0A, 1200
  END
END
