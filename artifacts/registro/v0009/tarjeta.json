ion 1, Unconfoundedness: If U→{treatment} and U→outcome then P(outcome|treatment,mom.scoll,drugs,mia,first,booze,twin,mom.hs,work.dur,nnhealth,mom.lths,prenatal,b.marr,momage,ein,har,birth.o,bw,preterm,b.head,sex,tex,was,cig,ark,pen,U) = P(outcome|treatment,mom.scoll,drugs,mia,first,booze,twin,mom.hs,work.dur,nnhealth,mom.lths,prenatal,b.marr,momage,ein,har,birth.o,bw,preterm,b.head,sex,tex,was,cig,ark,pen)\n",
